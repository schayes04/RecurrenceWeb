---
// Placeholder button. Before launch, swap in Apple's official localized
// "Download on the App Store" badges (developer.apple.com/app-store/marketing/guidelines/).
import { appStoreUrl, type Locale } from '../i18n/locales';
import { UI } from '../i18n/ui';

interface Props { locale: Locale; variant?: 'light' | 'dark' }
const { locale, variant = 'light' } = Astro.props;
---
<a class:list={['btn', variant === 'light' ? 'btn-light' : 'btn-dark']} href={appStoreUrl(locale)} rel="noopener">
  <svg aria-hidden="true" width="18" height="22" viewBox="0 0 18 22" fill="currentColor"><path d="M14.9 11.7c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9s-2-.9-3.4-.9C4.4 5.9 2.8 7 1.9 8.6 0 11.9 1.4 16.8 3.2 19.4c.9 1.3 2 2.7 3.3 2.6 1.3-.1 1.8-.8 3.4-.8s2 .8 3.4.8c1.4 0 2.3-1.3 3.2-2.6 1-1.5 1.4-2.9 1.4-3-.1 0-2.9-1.1-3-4.7zM12.3 4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.2 1.1.1 2.3-.6 3-1.5z"/></svg>
  {UI[locale].download}
</a>
