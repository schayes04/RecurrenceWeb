---
import { Image } from 'astro:assets';
import icon from '../assets/brand/icon.png';
import { LOCALES, type Locale } from '../i18n/locales';
import { USE_CASES, COMPETITORS, pathFor, type PageKey } from '../i18n/routes';
import { UI } from '../i18n/ui';
import { contentFor, isPublished } from '../content';

interface Props { locale: Locale; pageKey?: PageKey }
const { locale, pageKey } = Astro.props;
const ui = UI[locale];
const c = contentFor(locale);
const year = new Date().getFullYear();
// Comparison links appear once those pages are published in this locale.
const competitors = COMPETITORS.filter((id) => isPublished(locale, `compare/${id}`));
---
<footer class="site-footer dark">
  <div class="container">
    <div class="cols">
      <div class="col brand-col">
        <a class="brand" href={pathFor('home', locale)}><Image src={icon} alt="" width={28} height={28} />Recurrence</a>
        <p>{ui.platforms}</p>
      </div>
      <nav class="col" aria-labelledby="f-track">
        <h2 id="f-track"><a href={pathFor('use-cases', locale)}>{ui.nav.useCases}</a></h2>
        {USE_CASES.map((id) => <a href={pathFor(`use-case/${id}`, locale)}>{c.useCases[id].name}</a>)}
      </nav>
      {competitors.length > 0 && (
        <nav class="col" aria-labelledby="f-compare">
          <h2 id="f-compare"><a href={pathFor('compare', locale)}>{ui.nav.compare}</a></h2>
          {competitors.map((id) => <a href={pathFor(`compare/${id}`, locale)}>{c.compare[id].name}</a>)}
        </nav>
      )}
      <nav class="col" aria-labelledby="f-app">
        <h2 id="f-app">Recurrence</h2>
        <a href={pathFor('features', locale)}>{ui.nav.features}</a>
        <a href={pathFor('pricing', locale)}>{ui.nav.pricing}</a>
        <a href={pathFor('support', locale)}>{ui.footer.support}</a>
        <a href={pathFor('press', locale)}>{ui.footer.press}</a>
        <a href={pathFor('privacy', locale)}>{ui.footer.privacy}</a>
        <a href={pathFor('terms', locale)}>{ui.footer.terms}</a>
      </nav>
    </div>
    <nav class="langs" aria-label={ui.language}>
      {LOCALES.map((l) => <a href={pathFor(pageKey ?? 'home', l.code)} hreflang={l.hreflang[0]} lang={l.htmlLang}>{l.name}</a>)}
    </nav>
    <p class="legal">© {year} · {ui.footer.madeBy}</p>
  </div>
</footer>
