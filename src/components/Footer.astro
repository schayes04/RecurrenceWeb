---
import { Image } from 'astro:assets';
import icon from '../assets/brand/icon.png';
import type { Locale } from '../i18n/locales';
import { USE_CASES, COMPETITORS, pathFor, type PageKey } from '../i18n/routes';
import { UI } from '../i18n/ui';
import { contentFor, isPublished } from '../content';

interface Props { locale: Locale; pageKey?: PageKey }
const { locale, pageKey } = Astro.props;
const ui = UI[locale];
const c = contentFor(locale);
const [madeByBefore, madeByAfter] = ui.footer.madeBy.split('Shayes Apps');
const social = [
  { name: 'Facebook', href: 'https://www.facebook.com/shayesapps' },
  { name: 'Instagram', href: 'https://www.instagram.com/shayesapps/' },
  { name: 'Mastodon', href: 'https://indieapps.space/@shayesapps' },
];
// Comparison links appear once those pages are published in this locale.
const competitors = COMPETITORS.filter((id) => isPublished(locale, `compare/${id}`));
---
<footer class="site-footer dark">
  <div class="container">
    <div class:list={['cols', competitors.length > 0 && 'four']}>
      <div class="col brand-col">
        <a class="brand" href={pathFor('home', locale)}><Image src={icon} alt="" width={40} height={40} />Recurrence</a>
        <p class="made-by">{madeByBefore}<a href="https://shayesapps.com/" target="_blank" rel="noopener">Shayes Apps</a>{madeByAfter}</p>
      </div>
      <nav class="col" aria-labelledby="f-track">
        <h2 id="f-track"><a href={pathFor('use-cases', locale)}>{ui.footer.track}</a></h2>
        <ul>{USE_CASES.map((id) => <li><a href={pathFor(`use-case/${id}`, locale)}>{c.useCases[id].name}</a></li>)}</ul>
      </nav>
      {competitors.length > 0 && (
        <nav class="col" aria-labelledby="f-compare">
          <h2 id="f-compare"><a href={pathFor('compare', locale)}>{ui.nav.compare}</a></h2>
          <ul>{competitors.map((id) => <li><a href={pathFor(`compare/${id}`, locale)}>{c.compare[id].name}</a></li>)}</ul>
        </nav>
      )}
      <nav class="col" aria-labelledby="f-social">
        <h2 id="f-social">{ui.footer.social}</h2>
        <ul>
          <li><a href={pathFor('support', locale)}>{ui.nav.support}</a></li>
          {social.map((x) => <li><a href={x.href} target="_blank" rel="noopener me">{x.name}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>
</footer>
