---
import Base from '../layouts/Base.astro';
import Home from '../views/Home.astro';
import Features from '../views/Features.astro';
import UseCasesHub from '../views/UseCasesHub.astro';
import UseCase from '../views/UseCase.astro';
import CompareHub from '../views/CompareHub.astro';
import Compare from '../views/Compare.astro';
import Support from '../views/Support.astro';
import Press from '../views/Press.astro';
import Legal from '../views/Legal.astro';
import { allRoutes, pathFor, type PageKey, type UseCaseId, type CompetitorId } from '../i18n/routes';
import type { Locale } from '../i18n/locales';
import { UI } from '../i18n/ui';
import { contentFor, metaFor } from '../content';
import { appJsonLd, organizationJsonLd, breadcrumbJsonLd } from '../lib/seo';

export function getStaticPaths() {
  return allRoutes().map(({ locale, key, path }) => ({
    params: { path: path === '/' ? undefined : path.slice(1, -1) },
    props: { locale, pageKey: key },
  }));
}

interface Props { locale: Locale; pageKey: PageKey }
const { locale, pageKey } = Astro.props;
const c = contentFor(locale);
const meta = metaFor(c, pageKey);
const ui = UI[locale];

const crumb = (key: PageKey, name: string) => ({ name, path: pathFor(key, locale) });
const SECTION_NAMES: Partial<Record<PageKey, string>> = {
  features: ui.nav.features, 'use-cases': ui.nav.useCases, compare: ui.nav.compare,
  support: ui.nav.support, press: ui.nav.press, privacy: ui.footer.privacy, terms: ui.footer.terms,
};
const jsonLd: object[] = [];
if (pageKey === 'home') jsonLd.push(appJsonLd(locale, meta.description), organizationJsonLd());
if (pageKey === 'features') jsonLd.push(appJsonLd(locale, meta.description));
if (pageKey !== 'home') {
  const trail = [crumb('home', ui.breadcrumbHome)];
  if (pageKey.startsWith('use-case/')) trail.push(crumb('use-cases', ui.nav.useCases), crumb(pageKey, c.useCases[pageKey.slice(9) as UseCaseId].name));
  else if (pageKey.startsWith('compare/')) trail.push(crumb('compare', ui.nav.compare), crumb(pageKey, c.compare[pageKey.slice(8) as CompetitorId].name));
  else trail.push(crumb(pageKey, SECTION_NAMES[pageKey] ?? meta.title));
  jsonLd.push(breadcrumbJsonLd(trail));
}
---
<Base locale={locale} pageKey={pageKey} title={meta.title} description={meta.description} jsonLd={jsonLd}>
  {pageKey === 'home' && <Home locale={locale} c={c} />}
  {pageKey === 'features' && <Features locale={locale} c={c} />}
  {pageKey === 'use-cases' && <UseCasesHub locale={locale} c={c} />}
  {pageKey.startsWith('use-case/') && <UseCase locale={locale} c={c} id={pageKey.slice(9) as UseCaseId} />}
  {pageKey === 'compare' && <CompareHub locale={locale} c={c} />}
  {pageKey.startsWith('compare/') && <Compare locale={locale} c={c} id={pageKey.slice(8) as CompetitorId} />}
  {pageKey === 'support' && <Support locale={locale} c={c} />}
  {pageKey === 'press' && <Press locale={locale} c={c} />}
  {pageKey === 'privacy' && <Legal locale={locale} c={c} doc={c.privacy} pageKey={pageKey} />}
  {pageKey === 'terms' && <Legal locale={locale} c={c} doc={c.terms} pageKey={pageKey} />}
</Base>
