---
// /open/ launches the app through its URL scheme, like countdowns-app.com/open.
// One page for every language: a small script picks the visitor's language and
// swaps in its text, badge and App Store link. Noindex and left out of the sitemap.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import icon from '../assets/brand/icon.png';
import { LOCALES, DEFAULT_LOCALE, appStoreUrl } from '../i18n/locales';
import { UI } from '../i18n/ui';

const SCHEME = 'recurrence://';
const badges = import.meta.glob<ImageMetadata>('../assets/app-store-badges/white/*.svg', { eager: true, import: 'default' });
const strings = Object.fromEntries(LOCALES.map((l) => {
  const badge = badges[`../assets/app-store-badges/white/${l.badge}.svg`];
  return [l.code, { lang: l.htmlLang, opening: UI[l.code].opening, download: UI[l.code].download, store: appStoreUrl(l.code), badge: badge.src, ratio: badge.width / badge.height }];
}));
const en = strings[DEFAULT_LOCALE];
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Recurrence</title>
  <meta name="description" content="Open the Recurrence app on your iPhone, iPad or Mac." />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style>
    html, body { height: 100%; margin: 0; }
    body { display: grid; place-items: center; background: #14222D; color: #fff; font: 17px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; text-align: center; padding: 24px; box-sizing: border-box; }
    img.icon { width: 88px; height: 88px; border-radius: 20px; margin: 0 auto 20px; display: block; }
    h1 { font-size: 22px; font-weight: 600; margin: 0 0 28px; }
    a { display: inline-block; }
  </style>
  <script is:inline define:vars={{ strings, SCHEME }}>
    window.location.replace(SCHEME);
    // Pick the closest site language from the browser's preferences.
    const pick = (tag) => {
      const t = tag.toLowerCase();
      if (strings[tag]) return tag;
      if (t.startsWith('zh')) return /hant|tw|hk|mo/.test(t) ? 'zh-Hant' : 'zh-Hans';
      if (t === 'pt-pt') return 'pt-PT';
      if (t.startsWith('pt')) return 'pt-BR';
      if (t === 'es-es') return 'es-ES';
      if (t.startsWith('es')) return 'es';
      if (t === 'fr-ca') return 'fr-CA';
      if (t.startsWith('fr')) return 'fr';
      if (['en-gb', 'en-au', 'en-ca'].includes(t)) return 'en-' + t.slice(3).toUpperCase();
      return Object.keys(strings).find((k) => k.toLowerCase() === t.split('-')[0]);
    };
    document.addEventListener('DOMContentLoaded', () => {
      const code = (navigator.languages || [navigator.language]).map(pick).find(Boolean);
      const s = code && strings[code];
      if (!s) return;
      document.documentElement.lang = s.lang;
      document.querySelector('h1').textContent = s.opening;
      const a = document.querySelector('a');
      a.href = s.store;
      const img = a.querySelector('img');
      img.src = s.badge;
      img.alt = s.download;
      img.width = Math.round(s.ratio * 54);
    });
  </script>
</head>
<body>
  <main>
    <Image class="icon" src={icon} alt="" width={88} height={88} loading="eager" />
    <h1>{en.opening}</h1>
    <a href={en.store} rel="noopener"><img src={en.badge} width={Math.round(en.ratio * 54)} height="54" alt={en.download} /></a>
  </main>
</body>
</html>
