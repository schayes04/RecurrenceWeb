---
import { Image } from 'astro:assets';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { pathFor } from '../i18n/routes';
import { UI } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
import type { SiteContent } from '../content/types';
import { screenFor, ALT } from '../lib/screens';

interface Props { locale: Locale; c: SiteContent }
const { locale, c } = Astro.props;
const f = c.features;
---
<PageHead locale={locale} title={f.h1} lead={f.intro} crumbs={[{ name: UI[locale].nav.features, path: pathFor('features', locale) }]} />
{f.sections.map((s, i) => (
  <section class:list={['section', { soft: i % 2 === 1 }]}>
    <div class:list={['container', 'split', { reverse: i % 2 === 1 }]}>
      <div class="shot"><Image src={screenFor(s.screen, locale)} alt={ALT[s.screen]} widths={[300, 600]} sizes="300px" /></div>
      <div>
        <h2>{s.title}</h2>
        <p class="prose">{s.body}</p>
        <ul class="dots">{s.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>
))}
<CtaBand locale={locale} title={c.home.heroAccentBefore + c.home.heroAccent + c.home.heroAccentAfter} body={c.home.freeBody} />
