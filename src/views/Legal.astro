---
import PageHead from '../components/PageHead.astro';
import EmailText from '../components/EmailText.astro';
import type { Locale } from '../i18n/locales';
import type { LegalContent, SiteContent } from '../content/types';
import { pathFor, type PageKey } from '../i18n/routes';

interface Props { locale: Locale; c: SiteContent; doc: LegalContent; pageKey: PageKey }
const { locale, c, doc, pageKey } = Astro.props;
---
<PageHead locale={locale} title={doc.h1} lead={`${c.labels.lastUpdated}: ${doc.updated}`} crumbs={[{ name: doc.h1, path: pathFor(pageKey, locale) }]} />
<section class="section">
  <div class="container legal">
    {doc.sections.map((s) => <><h2>{s.title}</h2>{s.body.map((p) => <p><EmailText text={p} /></p>)}</>)}
  </div>
</section>
