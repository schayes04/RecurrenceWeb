---
import { Image } from 'astro:assets';
import PageHead from '../components/PageHead.astro';
import { pathFor } from '../i18n/routes';
import type { Locale } from '../i18n/locales';
import type { SiteContent } from '../content/types';
import icon from '../assets/brand/icon.png';
import { UI } from '../i18n/ui';

interface Props { locale: Locale; c: SiteContent }
const { locale, c } = Astro.props;
const p = c.press;
---
<PageHead locale={locale} title={p.h1} lead={p.intro} crumbs={[{ name: p.h1, path: pathFor('press', locale) }]} />
<section class="section">
  <div class="container">
    <dl class="facts">{p.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
    <div class="split" style="margin-top:56px">
      <div>
        <h2>{p.kitTitle}</h2>
        <p class="prose">{p.kitBody}</p>
        <p style="margin-top:24px"><a class="btn btn-dark" href="/press/Recurrence_Press_Kit.zip" download>{p.kitLink}</a></p>
        <h2 style="margin-top:48px;font-size:24px">{p.contactTitle}</h2>
        <p class="prose"><a href="mailto:support@shayesapps.com">{p.contactBody}</a></p>
      </div>
      <div class="shot"><Image src={icon} alt={UI[locale].appName} width={220} height={220} style="border-radius:48px" /></div>
    </div>
  </div>
</section>
