---
import PageHead from '../components/PageHead.astro';
import Faq from '../components/Faq.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import { pathFor } from '../i18n/routes';
import { UI } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
import type { SiteContent } from '../content/types';

interface Props { locale: Locale; c: SiteContent }
const { locale, c } = Astro.props;
const p = c.pricing;
const check = '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7"/></svg>';
---
<PageHead locale={locale} title={p.h1} lead={p.intro} crumbs={[{ name: UI[locale].nav.pricing, path: pathFor('pricing', locale) }]} />
<section class="section">
  <div class="container">
    <div class="plans">
      <div class="plan">
        <h2>{p.free.title}</h2>
        <p class="summary">{p.free.summary}</p>
        <ul>{p.free.items.map((i) => <li><Fragment set:html={check} />{i}</li>)}</ul>
      </div>
      <div class="plan featured">
        <h2>{p.premium.title}</h2>
        <p class="summary">{p.premium.summary}</p>
        <ul>{p.premium.items.map((i) => <li><Fragment set:html={check} />{i}</li>)}</ul>
        <p class="note">{p.premium.plans}</p>
      </div>
    </div>
    <div class="cta-row"><AppStoreButton locale={locale} variant="dark" /></div>
  </div>
</section>
<section class="section soft">
  <div class="container" style="max-width:820px">
    <h2>{c.labels.faqTitle}</h2>
    <Faq items={p.faq} />
  </div>
</section>
