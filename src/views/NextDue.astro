---
// Next due date calculator. Everything runs in the browser: nothing is stored
// or sent. Month and year intervals keep the start date's day of the month,
// moving to the month's last day when it's shorter (Jan 31 + 1 month = Feb 28).
// Opened from the guide with ?every=3&unit=month&task=air-filter.
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import { pathFor } from '../i18n/routes';
import { localeInfo, type Locale } from '../i18n/locales';
import type { ToolsContent } from '../content/types';
import { GUIDE, POPULAR, UNITS } from '../content/guide';

interface Props { locale: Locale; t: ToolsContent }
const { locale, t } = Astro.props;
const n = t.nextDue;
const entry = (id: string) => GUIDE.find((e) => e.id === id)!;
const cfg = {
  lang: localeInfo(locale).htmlLang,
  units: n.units,
  preset: n.preset,
  upcoming: n.upcoming,
  overdue: n.overdue,
  doneToday: n.doneToday,
  invalid: n.invalid,
  presets: Object.fromEntries(GUIDE.map((e) => [e.id, { every: e.every, unit: e.unit, name: t.howOften.items[e.id].name }])),
};
---
<PageHead locale={locale} title={n.h1} lead={n.intro} crumbs={[{ name: n.name, path: pathFor('tool/next-due', locale) }]} />
<section class="section calc-section">
  <div class="container calc-grid">
    <form class="calc" id="calc" novalidate>
      <p class="preset" id="preset" hidden></p>
      <div class="field">
        <label for="last">{n.lastDone}</label>
        <div class="row">
          <input type="date" id="last" min="1900-01-01" max="2999-12-31" required />
          <button type="button" class="chip" id="today">{n.today}</button>
        </div>
      </div>
      <div class="field">
        <label for="every" id="every-label">{n.every}</label>
        <div class="row">
          <input type="number" id="every" min="1" max="999" step="1" value="1" inputmode="numeric" required />
          <select id="unit" aria-labelledby="every-label">
            {UNITS.map((u) => <option value={u} selected={u === 'month'}>{n.units[u].other}</option>)}
          </select>
        </div>
      </div>
      <fieldset class="quick">
        <legend>{n.quickTitle}</legend>
        <div class="chips">
          {n.quick.map((q) => <button type="button" class="chip" data-every={q.every} data-unit={q.unit} aria-pressed="false">{q.label}</button>)}
        </div>
      </fieldset>
    </form>
    <div class="calc-result">
      <div aria-live="polite">
        <p class="label">{n.nextDue}</p>
        <time class="due" id="due">–</time>
        <p class="rel" id="rel"></p>
        <p class="hint" id="hint" hidden></p>
      </div>
      <h2 class="label">{n.afterThat}</h2>
      <ol class="after" id="after"></ol>
      <noscript><p class="rel">{n.noscript}</p></noscript>
      <div class="remind">
        <p>{n.remind}</p>
        <AppStoreButton locale={locale} height={44} />
      </div>
    </div>
  </div>
</section>
<section class="section soft">
  <div class="container">
    <h2>{n.popularTitle}</h2>
    <p class="sub">{n.popularBody}</p>
    <div class="popular">
      {POPULAR.map((id) => {
        const e = entry(id);
        return (
          <button type="button" class="card" data-task={id} data-every={e.every} data-unit={e.unit}>
            <strong>{t.howOften.items[id].name}</strong>
            <span>{t.howOften.items[id].often}</span>
          </button>
        );
      })}
    </div>
    <p class="more-link"><a href={pathFor('tool/how-often', locale)}>{n.guideLink} →</a></p>
  </div>
</section>
<section class="section">
  <div class="container narrow">
    <h2>{n.howTitle}</h2>
    <ol class="steps">{n.howSteps.map((s) => <li>{s}</li>)}</ol>
    <p class="prose">{n.howNote}</p>
  </div>
</section>
<section class="section soft">
  <div class="container narrow">
    <h2>{n.faqTitle}</h2>
    <Faq items={n.faq} />
  </div>
</section>
<CtaBand locale={locale} title={n.ctaTitle} body={n.ctaBody} />

<script is:inline define:vars={{ cfg }}>
  (() => {
    const $ = (id) => document.getElementById(id);
    const last = $('last'), every = $('every'), unit = $('unit'), preset = $('preset');
    const due = $('due'), rel = $('rel'), hint = $('hint'), after = $('after');
    const chips = [...document.querySelectorAll('.quick .chip')];

    const pad = (v) => String(v).padStart(2, '0');
    const iso = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const today = () => { const d = new Date(); return new Date(d.getFullYear(), d.getMonth(), d.getDate()); };
    const parse = (s) => {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
      if (!m) return null;
      const d = new Date(+m[1], +m[2] - 1, +m[3]);
      return d.getDate() === +m[3] ? d : null;
    };
    // The k-th date after start. Counting each one from start keeps the 31st at month end.
    const add = (start, count, u, k) => {
      const y = start.getFullYear(), m = start.getMonth(), day = start.getDate();
      if (u === 'day' || u === 'week') return new Date(y, m, day + count * k * (u === 'week' ? 7 : 1));
      const month = m + count * k * (u === 'year' ? 12 : 1);
      return new Date(y, month, Math.min(day, new Date(y, month + 1, 0).getDate()));
    };
    const daysBetween = (a, b) => Math.round((Date.UTC(b.getFullYear(), b.getMonth(), b.getDate()) - Date.UTC(a.getFullYear(), a.getMonth(), a.getDate())) / 864e5);

    const long = new Intl.DateTimeFormat(cfg.lang, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    const short = new Intl.DateTimeFormat(cfg.lang, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
    const relative = new Intl.RelativeTimeFormat(cfg.lang, { numeric: 'auto' });
    const plural = new Intl.PluralRules(cfg.lang);

    const render = () => {
      const count = Number(every.value);
      const valid = Number.isInteger(count) && count >= 1 && count <= 999;
      const form = plural.select(valid ? count : 2);
      for (const o of unit.options) o.textContent = cfg.units[o.value][form] ?? cfg.units[o.value].other;
      for (const c of chips) c.setAttribute('aria-pressed', String(+c.dataset.every === count && c.dataset.unit === unit.value));

      const start = parse(last.value);
      if (!start || !valid) {
        due.textContent = '–';
        due.removeAttribute('datetime');
        rel.textContent = cfg.invalid;
        hint.hidden = true;
        after.replaceChildren();
        return;
      }
      const now = today();
      const next = add(start, count, unit.value, 1);
      const diff = daysBetween(now, next);
      due.textContent = long.format(next);
      due.dateTime = iso(next);
      // Overdue: show when it was due, then count the following dates from today.
      const base = diff < 0 ? now : start;
      rel.textContent = (diff < 0 ? cfg.overdue : cfg.upcoming).replace('{rel}', relative.format(diff, 'day'));
      hint.hidden = diff >= 0;
      if (diff < 0) hint.textContent = cfg.doneToday.replace('{date}', long.format(add(now, count, unit.value, 1)));
      after.replaceChildren(...[2, 3, 4, 5, 6].map((k) => {
        const d = add(base, count, unit.value, k);
        const li = document.createElement('li');
        const time = document.createElement('time');
        time.dateTime = iso(d);
        time.textContent = short.format(d);
        li.append(time);
        return li;
      }));
    };

    const applyInterval = (count, u, task) => {
      every.value = count;
      unit.value = u;
      preset.hidden = !task;
      if (task) preset.textContent = cfg.preset.replace('{task}', cfg.presets[task].name);
      render();
    };

    last.value = iso(today());
    const q = new URLSearchParams(location.search);
    const qEvery = Number(q.get('every')), qUnit = q.get('unit'), qTask = q.get('task');
    if (Number.isInteger(qEvery) && qEvery >= 1 && qEvery <= 999 && Object.hasOwn(cfg.units, qUnit)) applyInterval(qEvery, qUnit, Object.hasOwn(cfg.presets, qTask) ? qTask : null);
    else render();

    last.addEventListener('input', render);
    every.addEventListener('input', () => { preset.hidden = true; render(); });
    unit.addEventListener('change', () => { preset.hidden = true; render(); });
    $('today').addEventListener('click', () => { last.value = iso(today()); render(); });
    for (const c of chips) c.addEventListener('click', () => applyInterval(+c.dataset.every, c.dataset.unit, null));
    const calc = $('calc');
    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const b of document.querySelectorAll('.popular [data-task]')) {
      b.addEventListener('click', () => {
        applyInterval(+b.dataset.every, b.dataset.unit, b.dataset.task);
        calc.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
      });
    }
    calc.addEventListener('submit', (e) => e.preventDefault());
  })();
</script>
